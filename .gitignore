# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets
.env
.env.local

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Workspace contents — the shared cloud state is runtime data,
# not source. Keep the directory structure via .gitkeep files.
workspace/messages/*
workspace/documents/*
workspace/decisions/*
!workspace/messages/.gitkeep
!workspace/documents/.gitkeep
!workspace/decisions/.gitkeep
