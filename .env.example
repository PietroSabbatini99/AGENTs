# Copy this file to `.env` and fill in your values.

# Base URL for the OpenAI-compatible API.
# Default: Ollama at http://localhost:11434/v1
# AGENT_TEAM_BASE_URL=http://localhost:11434/v1

# API key (optional for local Ollama — required for remote providers).
# AGENT_TEAM_API_KEY=sk-...

# Model name. Default: qwen3.5:4b (pull it with `ollama pull qwen3.5:4b`).
# AGENT_TEAM_MODEL=qwen3.5:4b
